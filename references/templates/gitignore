# ============================================================
# .gitignore — 通用部分（任何项目都写这一半）
# ============================================================

# 临时文件与运行记录（不进版本库）
logs/
*.tmp
*.bak
~$*

# 产物区：由源生成的最终交付物（勿手改）—— 默认不进库（可由源重新生成）
# 说明：要对外留存的定版，由使用者从 dist/ 手动复制进 release/（release/ 不忽略；见 versions.md §八）。
dist/

# Agent / 平台产物（可再生、非存档）
.trae/
.trae-html-share-packages/
.claude/
.cursor/

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

# ============================================================
# .gitignore — 代码相关追加部分（有代码 / 有依赖时写这一半）
# ============================================================

# 依赖目录
node_modules/
.venv/
venv/
__pycache__/
*.pyc
vendor/

# 构建输出（编译 / 打包缓存等；产物区见上方 dist/）
build/
out/
target/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# 缓存与日志
.cache/
*.log
